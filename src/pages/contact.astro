---
import Base from '../layouts/Base.astro';
import { studio } from '../config/studio';
import { projects } from '../data/projects';
const c = studio.contact;
const map = Object.fromEntries(projects.map((p) => [p.slug, p.title]));
const areaUnits = ['sq ft', 'sq m'];
---
<Base title="Contact" description="Send an enquiry to Shaili Design Studio about an architecture or interior design project.">
  <section class="wrap section grid gap-16 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="num mb-4">Contact</p>
      <h1 class="h-lg">Tell us about your <span class="gold-i">project</span>.</h1>
      <div class="mt-10 space-y-4 text-sm">
        {c.email && <p><a class="hover:text-primary" href={`mailto:${c.email}`}>{c.email}</a></p>}
        {c.phone && <p><a class="hover:text-primary" href={`tel:${c.phone.replace(/[^+\d]/g, '')}`}>{c.phone}</a></p>}
        {c.whatsapp && <p><a class="hover:text-primary" href={`https://wa.me/${c.whatsapp}`} rel="noopener">WhatsApp</a></p>}
        {studio.social.instagram && <p><a class="hover:text-primary" href={studio.social.instagram} rel="noopener noreferrer" target="_blank">Instagram</a></p>}
        {studio.social.facebook && <p><a class="hover:text-primary" href={studio.social.facebook} rel="noopener noreferrer" target="_blank">Facebook</a></p>}
        {c.address && <p class="text-muted-foreground">{c.address}</p>}
        {!c.email && !c.phone && !c.whatsapp && !c.address && <p class="text-muted-foreground">Use the form and the studio will reply by email.</p>}
      </div>
    </div>

    <div class="lg:col-span-7 lg:col-start-6">
      <p id="proj-note" class="mb-6 border border-primary p-4 text-sm" hidden></p>
      <form id="enquiry" method="POST" action="https://api.web3forms.com/submit" novalidate class="grid gap-6" data-projects={JSON.stringify(map)}>
        <input type="hidden" name="access_key" value={studio.web3formsKey} />
        <input type="hidden" name="subject" value="New enquiry: Shaili Design Studio website" />
        <input type="hidden" name="from_name" value="Shaili Design Studio website" />
        {studio.siteUrl && <input type="hidden" name="redirect" value={`${studio.siteUrl.replace(/\/$/, '')}/thank-you/`} />}
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="project" id="f-project" value="" />
        <input type="hidden" name="source" value="website contact form" />

        <div><label class="lbl" for="name">Full name *</label><input class="field" id="name" name="name" required maxlength="100" autocomplete="name" /></div>
        <div><label class="lbl" for="email">Email *</label><input class="field" id="email" name="email" type="email" required maxlength="150" autocomplete="email" /></div>
        <div><label class="lbl" for="service">Service interest *</label>
          <select class="field" id="service" name="service" required><option value="">Select…</option><option>Architecture</option><option>Interiors</option><option>Both</option><option>Not sure</option></select></div>
        <div><label class="lbl" for="city">City *</label><input class="field" id="city" name="city" required maxlength="100" autocomplete="address-level2" /></div>
        <div><label class="lbl" for="message">Project description *</label><textarea class="field" id="message" name="message" rows="6" required minlength="10" maxlength="3000"></textarea></div>

        <details class="border border-border p-4">
          <summary class="cursor-pointer text-xs tracking-widest uppercase min-h-12 flex items-center">Optional details</summary>
          <div class="grid gap-6 pt-4">
            <div><label class="lbl" for="phone">Phone</label><input class="field" id="phone" name="phone" type="tel" inputmode="tel" maxlength="25" pattern="[+()0-9\s.\-]{7,25}" autocomplete="tel" /></div>
            <div class="grid grid-cols-[1fr_auto] gap-3"><div><label class="lbl" for="area">Approximate area</label><input class="field" id="area" name="area" inputmode="decimal" maxlength="12" /></div>
              <div><label class="lbl" for="area_unit">Unit</label><select class="field" id="area_unit" name="area_unit">{areaUnits.map((u) => <option>{u}</option>)}</select></div></div>
            <div><label class="lbl" for="budget">Budget range</label><select class="field" id="budget" name="budget"><option>Not decided</option><option>Under 25 lakh INR</option><option>25–75 lakh INR</option><option>75 lakh–2 crore INR</option><option>Above 2 crore INR</option></select></div>
            <div><label class="lbl" for="timeline">Preferred timeline</label><select class="field" id="timeline" name="timeline"><option>Flexible</option><option>Within 3 months</option><option>3–6 months</option><option>6–12 months</option><option>More than 12 months</option></select></div>
          </div>
        </details>

        <div><label class="flex gap-3 text-sm items-start"><input type="checkbox" id="consent" name="consent" value="yes" required class="mt-1 h-5 w-5 accent-[hsl(44_53%_54%)]" /><span>I agree the studio may reply to me about this enquiry. See the <a class="underline" href="/privacy/">privacy page</a>. *</span></label></div>

        {!studio.web3formsKey && <p class="mb-4 border border-primary p-3 text-sm">The enquiry form is not connected yet (owner: add the Web3Forms access key in studio.ts).</p>}
        <div><button type="submit" id="send" disabled={!studio.web3formsKey} class="btn btn-solid"><span>Send enquiry</span></button>
          <p id="status" role="status" aria-live="polite" class="mt-4 text-sm"></p></div>
      </form>
    </div>
  </section>
</Base>
<script>
  const form = document.getElementById('enquiry') as HTMLFormElement;
  const status = document.getElementById('status')!, send = document.getElementById('send') as HTMLButtonElement;
  // Resolve ?project=<slug> against known data; textContent only (no HTML injection)
  const map = JSON.parse(form.dataset.projects || '{}') as Record<string, string>;
  const slug = new URLSearchParams(location.search).get('project') || '';
  if (Object.prototype.hasOwnProperty.call(map, slug)) {
    (document.getElementById('f-project') as HTMLInputElement).value = map[slug];
    const n = document.getElementById('proj-note')!; n.textContent = `Enquiring about: ${map[slug]}`; n.hidden = false;
  }
  const clear = () => form.querySelectorAll('.err').forEach((e) => e.remove());
  function validate() {
    clear(); let first: HTMLElement | null = null;
    form.querySelectorAll<HTMLInputElement>('input,select,textarea').forEach((el) => {
      el.removeAttribute('aria-invalid');
      if (!el.willValidate || el.validity.valid) return;
      let msg = el.validationMessage;
      if (el.validity.valueMissing) msg = el.type === 'checkbox' ? 'Please tick to allow a reply.' : 'This field is required.';
      else if (el.validity.typeMismatch) msg = 'Enter a valid email address, like name@example.com.';
      else if (el.validity.patternMismatch) msg = 'Use digits with an optional + and spaces, e.g. +91 98765 43210.';
      else if (el.validity.tooShort) msg = 'Please add a little more detail.';
      const p = document.createElement('p'); p.className = 'err'; p.id = el.id + '-err'; p.textContent = msg;
      el.setAttribute('aria-invalid', 'true'); el.setAttribute('aria-describedby', p.id);
      (el.type === 'checkbox' ? el.closest('label')!.parentElement! : el.parentElement!).appendChild(p);
      first ||= el;
    });
    if (first) { (first as HTMLElement).focus(); status.textContent = 'Please fix the highlighted fields.'; }
    return !first;
  }
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (send.disabled) return;
    if (!validate()) return;
    send.disabled = true; status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
      const out = await res.json().catch(() => ({}));
      if (!res.ok || !out.success) throw new Error(String(res.status));
      location.href = '/thank-you/';
    } catch {
      status.textContent = 'Your enquiry could not be sent. Your details are still here. Please try again, or email the studio if it keeps happening.';
      send.disabled = false;
    }
  });
</script>