---
import Base from '../layouts/Base.astro';
const svc = [
  ['Architecture', 'Well suited to', ['New private residences', 'Extensions and remodelling', 'Small pavilions and studios'], 'We shape the form, plan and openings of a building around its site, climate and how you will use it.'],
  ['Interior design', 'Well suited to', ['Apartments and homes', 'Studios and workspaces', 'Single rooms and renovations'], 'We plan layouts, joinery, lighting, materials and furnishings so rooms are comfortable and cohesive.'],
];
---
<Base title="Services" description="Architecture and interior design services from Shaili Design Studio, and how an initial consultation works.">
  <section class="wrap section">
    <p class="num mb-4">Services</p>
    <h1 class="h-xl max-w-4xl">Architecture and <span class="gold-i">interiors</span>.</h1>
    <div class="mt-20 grid gap-px bg-border md:grid-cols-2">
      {svc.map(([t, w, l, d], i) => (
        <section class="bg-background p-10 md:p-14" data-reveal>
          <span class="num">0{i + 1}</span>
          <h2 class="font-display text-5xl mt-2">{t}</h2>
          <p class="lead mt-5">{d}</p>
          <h3 class="mt-8 text-xs tracking-widest uppercase text-muted-foreground font-sans">{w}</h3>
          <ul class="mt-3 space-y-2">{(l as string[]).map((x) => <li class="border-t border-border pt-2">{x}</li>)}</ul>
        </section>
      ))}
    </div>
    <div class="mt-24 max-w-3xl" data-reveal>
      <h2 class="h-lg">The initial <span class="gold-i">consultation</span></h2>
      <p class="lead mt-6">An enquiry starts a conversation. We talk through your space, goals, timeline and budget, and agree whether and how we can work together. The studio will confirm scope and next steps with you directly.</p>
      <a href="/contact/" class="btn btn-solid mt-8"><span>Book a consultation</span></a>
    </div>
  </section>
</Base>
