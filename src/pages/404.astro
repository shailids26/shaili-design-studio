---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="wrap section text-center">
    <p class="text-stroke font-display text-[clamp(6rem,24vw,18rem)] leading-none" aria-hidden="true">404</p>
    <h1 class="h-lg">This page isn’t <span class="gold-i">here</span>.</h1>
    <p class="lead mx-auto mt-4">The link may be old or mistyped.</p>
    <div class="mt-8 flex justify-center gap-4"><a href="/" class="btn btn-solid"><span>Home</span></a><a href="/projects/" class="btn"><span>All projects</span></a></div>
  </section>
</Base>
