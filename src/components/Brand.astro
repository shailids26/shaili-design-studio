---
const { size = 'md' } = Astro.props;
---
<span class="inline-flex items-center gap-3">
  <img src="/images/logo.png" alt="" width="48" height="48" class:list={[size === 'lg' ? 'h-14 w-14' : 'h-11 w-11']} />
  <span class="flex flex-col leading-none whitespace-nowrap sm:flex-row sm:items-baseline sm:gap-2"><span class="brand-script">Shaili</span><span class="brand-serif">Design Studio</span></span>
</span>