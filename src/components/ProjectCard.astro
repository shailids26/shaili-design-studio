---
import type { Project } from '../data/projects';
const { p, i = 0 } = Astro.props as { p: Project; i?: number };
const pos = i % 4;
---
<article data-reveal data-card data-pos={pos} data-title={p.title.toLowerCase()} data-cat={p.category} class="group">
  <a href={`/projects/${p.slug}/`} class="card-link block focus-visible:outline-offset-8">
    <div class="img-wrap bg-card">
      <img src={p.cover} alt={p.coverAlt} width="1600" height="1100" loading="lazy" decoding="async" class="h-full w-full object-cover" />
    </div>
    <div class="mt-5 flex items-baseline justify-between gap-4 border-b border-border pb-4">
      <h3 class="font-display text-3xl md:text-4xl group-hover:text-primary transition-colors">{p.title}</h3>
      <span class="num text-sm shrink-0">{p.category}</span>
    </div>
    <p class="mt-3 text-xs text-muted-foreground">{[p.status, p.location, p.year].filter(Boolean).join(' · ')}{p.demo && ' · Illustrative sample'}</p>
  </a>
</article>